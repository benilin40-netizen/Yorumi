# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase (Client-Safe & Server-Only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Streaming Providers (Backend Only)
YENIME_API_BASE_URL=https://api.yenime.net
YENIME_EMBED_TEMPLATE=https://player.yenime.net/anime/ani/{ANILIST_ID}/{EPISODE}
ANIEMBED_BASE_URL=https://aniembed.se/e
ANIEMBED_TEMPLATE=https://aniembed.se/e/{ANILIST_ID}/{EPISODE}?lang={LANG}&autoplay={AUTOPLAY}&t={START}
KUROKO_API_BASE_URL=https://kuroko.cc/api/v1
KUROKO_EMBED_BASE_URL=https://kuroko.cc/embed
KUROKO_EMBED_TEMPLATE=https://kuroko.cc/embed/ani/{anilist_id}/{episode}/{language}
KUROKO_ENABLED=true

# External Metadata & Schedule APIs (Backend Only)
ANILIST_API_URL=https://graphql.anilist.co
JIKAN_API_URL=https://api.jikan.moe/v4

# Admin Console Password (set in environment / Secrets; never commit a real value)
ADMIN_PASSWORD=
